{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/app.py"],
      "env": { "SHADES_API_PORT": "8010", "SHADES_DB": "data/preview.db" },
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5180", "--strictPort"],
      "env": { "VITE_API_URL": "http://127.0.0.1:8010" },
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "phone"],
      "env": { "SHADES_API_PORT": "8010" },
      "port": 4173,
      "autoPort": false
    }
  ]
}
